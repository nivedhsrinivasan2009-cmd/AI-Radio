# AI Radio — environment variable template
# Copy this file to .env and fill in real values.
# .env is gitignored; this template is committed.

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- News (https://newsapi.org/) ---
NEWS_API_KEY=your_newsapi_key

# --- Traffic (https://developer.tomtom.com/) ---
TOMTOM_API_KEY=your_tomtom_key

# --- Commodity prices (https://metalpriceapi.com/) ---
METALPRICE_API_KEY=your_metalprice_key

# --- LLM (Ollama) ---
LLM_MODEL=gemma3:12b
LLM_FALLBACK_MODEL=qwen2.5:7b-instruct

# --- Alerts: serious show problems are WhatsApp'd here (your own phone) ---
ALERT_WHATSAPP_TO=whatsapp:+9715XXXXXXXX

# --- Station integration (pretend station by default; change when the engineer confirms) ---
# STATION_LOG_DIR=station_data/logs              # log_YYYY-MM-DD.csv files
# SONG_TABLE_PATH=station_data/songs.csv
# DROPBOX_DIR=station_data/audiovault_dropbox     # where finished AI carts are dropped
# NOWPLAYING_FILE=                                # automation now-playing file; empty = log-only timing

# --- Audio (broadcast defaults) ---
# TARGET_LUFS=-16      # run: python -m airadio measure-loudness <station music folder>  and use its average
# TTS_ENGINE=gtts
